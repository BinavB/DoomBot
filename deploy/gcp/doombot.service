[Unit]
Description=DOOMBOT
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=doombot
WorkingDirectory=/opt/doombot
EnvironmentFile=/etc/doombot.env
ExecStart=/usr/bin/npx next start -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
